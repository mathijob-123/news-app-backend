{
  "name": "spotlight-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Backend API server for Spotlight with Supabase PostgreSQL",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
